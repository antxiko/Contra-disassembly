# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8000 mueve_sprites la rutina del objeto IY (sprite) segun su tipo IY+4 (la tabla de detras)
L 0x8063 mueve_objetos la rutina del objeto IY (de 0xE500) segun su tipo IY+4 (la tabla de detras)
L 0x81B4 suma_y suma A a la y de la ficha IY
L 0x81BB suma_x suma A a la x de la ficha IY
L 0x8372 suma_3000 suma 0x30 a los puntos
L 0x83C7 crea_objeto pone en la ficha IX un objeto del tipo C, dibujo B, en la posicion de IY + H (x) y L (y)
L 0x83E9 alterna_piezas cada A cuadros pinta en el fondo la pieza HL o la DE, por turnos
L 0x8400 pinta_pieza pinta en el fondo la pieza DE en la casilla de la ficha (IY+6/IY+7), con p03:BD1F
L 0x8419 busca_cuatro IX = cuatro fichas libres seguidas en 0xE400 (de dos en dos); acarreo si no hay
L 0x843F busca_dos IX = dos fichas libres seguidas en 0xE400; acarreo si no hay
L 0x8448 busca_dos_e380 IX = dos fichas libres seguidas en 0xE380; acarreo si no hay
L 0x8479 busca_una IX = una ficha libre de 0xE380 (de 19); acarreo si no hay
L 0x847E busca_una_de_8 IX = una ficha libre de 0xE380 (de 8); acarreo si no hay
L 0x9085 tocado si le da un disparo (p00:5AF8 con la caja HL) cuenta un golpe; con mas de A, explota (tipo 0x1D): acarreo
L 0x90AD tocado_1c como p02:9085, pero al explotar pasa al tipo 0x1C
L 0x90B1 tocado_1d como p02:9085, pero al explotar pasa al tipo 0x1D
L 0x9915 cuenta_c sube la cuenta IY+0C; al llegar a A vuelve a 0 y da acarreo (cada A cuadros)
L 0x9921 cuenta_d lo mismo con la cuenta IY+0D (p02:9915 con IY + 1)
L 0x9FFA pon_figura pone la figura HL (dy, dx, dibujo) en la ficha IY y en la de debajo (IY+10, dibujo + 4)
C 0x8003 despacha_e: salta por la tabla que va detras del call, con el indice en E
C 0x8066 despacha_e: salta por la tabla que va detras del call, con el indice en E
C 0x80EA el tipo del objeto (p02:8000, p02:8063) = 0x1B
C 0x80F7 pinta_pieza: pinta en el fondo la pieza DE en la casilla de la ficha (IY+6/IY+7), con p03:BD1F
C 0x8102 alterna_piezas: cada A cuadros pinta en el fondo la pieza HL o la DE, por turnos
C 0x811A le_da_un_disparo: acarreo si un disparo del jugador (0xE340 y siguientes) toca la caja HL de la ficha IY
C 0x812A tocado_1d: como p02:9085, pero al explotar pasa al tipo 0x1D
C 0x8135 el dibujo del objeto (p00:4BBB) = 0x01
C 0x813D suma_puntos: suma A a los puntos (0xE037-0xE038, BCD) y mira la vida de mas
C 0x8146 el estado del objeto (p03:A03E) = 0x01
C 0x8153 la x del objeto (p00:4BBB) = 0x18
C 0x8157 la y del objeto (p00:4BBB) = 0x40
C 0x815F la y guardada del objeto (p02:9A24) = 0x01
C 0x8171 suma_200: suma 2 a los puntos
C 0x8180 libera: libera la ficha IY (a cero, y fuera de la pantalla)
